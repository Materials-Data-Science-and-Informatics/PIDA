# Contact person name: Leyla Jael Castro
# Contact person email:  ljgarcia@zbmed.de 
# Artifacts: connoss
# Artifacts Names: ConnOSS metadata schema
# Resource location: https://connoss-project.github.io/vocab/connoss_Software.ttl

Options +FollowSymLinks

# Turn off MultiViews
Options -MultiViews

# Directive to ensure files served as appropriate content type
AddType text/turtle .ttl

RewriteEngine on

# Rewrite rule for HTML requests to the root
RewriteCond %{HTTP_ACCEPT} !application/rdf+xml.(text/html|application/xhtml+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.
RewriteRule ^$ https://connoss-project.github.io/vocab/ [R=303,L]

# Rewrite rule for RDF/Turtle requests to the root
RewriteCond %{HTTP_ACCEPT} ^.application/rdf+xml. [OR]
RewriteCond %{HTTP_ACCEPT} ^.application/xml. [OR]
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^$ https://connoss-project.github.io/vocab/connoss_Software.ttl [R=303,NE,L]

# Default response for the root
RewriteRule ^$ https://connoss-project.github.io/vocab/ [R=303,L]

# Catch-all rule to redirect any sub-paths to the corresponding path on the target website
RewriteRule ^(.*)$ https://connoss-project.github.io/vocab/$1 [R=303,L]